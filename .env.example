# Garmin Connect Credentials
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password

# Optional: Token storage locations
# GARMINTOKENS=/path/to/token/directory  # Default: ~/.garminconnect
# GARMINTOKENS_BASE64=/path/to/token.txt  # Default: ~/.garminconnect_base64

# Intervals.icu Credentials (optional, separate tool set — see README)
# Get these from intervals.icu > Settings > Developer Settings
# INTERVALS_API_KEY=your_api_key
# INTERVALS_ATHLETE_ID=i12345
