# Garmin Connect Credentials
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password

# Optional: Token storage locations
# GARMINTOKENS=/path/to/token/directory  # Default: ~/.garminconnect
# GARMINTOKENS_BASE64=/path/to/token.txt  # Default: ~/.garminconnect_base64

# Intervals.icu Credentials (optional, separate tool set — see README)
# Get these from intervals.icu > Settings > Developer Settings
# INTERVALS_API_KEY=your_api_key
# INTERVALS_ATHLETE_ID=i12345

# Open-Meteo (optional, separate tool set — see README)
# No API key needed — free for non-commercial use (up to 10,000 calls/day).
# Nothing to configure here.

# AEMET Credentials (Spain, optional, separate tool set — see README)
# Free key delivered by email — request one at
# https://opendata.aemet.es/centrodedescargas/inicio
# AEMET_API_KEY=your_api_key

# MeteoCat Credentials (Catalonia, optional, separate tool set — see README)
# Free, but registration requires a NIF/CIF and choosing a data subscription;
# approval can take up to ~7 days — see README's Weather Integration section
# before you start. Register at https://apidocs.meteocat.gencat.cat/
# METEOCAT_API_KEY=your_api_key
